{
  "name": "breast-cancer-chemo-dose-calculator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test packages/calculation-core/tests/*.test.mjs",
    "test:ui": "node --test tests/*.test.mjs",
    "build:catalogue": "python3 scripts/build-catalogue.py",
    "build:web": "node scripts/build-web.mjs",
    "typecheck": "tsc --noEmit --strict --target ES2020 --module ESNext packages/calculation-core/src/index.ts",
    "test:ocr": "node tests/ocr-smoke.mjs"
  },
  "devDependencies": {
    "happy-dom": "20.8.4",
    "typescript": "5.9.3",
    "tesseract.js": "7.0.0"
  }
}
